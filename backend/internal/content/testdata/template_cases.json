{
  "comment": "Shared by the Go validator (content/validate_test.go) and the TypeScript port (web/src/domain/template.test.ts). Each case checks one field: its text is `text`, or `repeat.unit` written `repeat.count` times. `problems` is what Validate reports for that field, in order, as code and params; Msg is English text for logs and is not part of the contract. Characters are counted in runes (code points), so a decomposed letter or a ZWJ emoji sequence counts every part.",
  "limits": { "sms": 160, "email_subject": 80, "email_body": 2000 },
  "cases": [
    { "name": "valid text with both variables", "field": "sms", "text": "Merhaba {{first_name}}, {{city}} için fırsat", "problems": [] },
    { "name": "no variables", "field": "sms", "text": "Kampanya başladı", "problems": [] },
    { "name": "repeated variable", "field": "sms", "text": "{{first_name}} {{city}} {{city}}", "problems": [] },
    { "name": "empty", "field": "sms", "text": "", "problems": [{ "code": "empty", "params": {} }] },
    { "name": "blank", "field": "email_subject", "text": " \n\t", "problems": [{ "code": "empty", "params": {} }] },
    { "name": "replacement character", "field": "sms", "text": "Merhaba \ufffd", "problems": [{ "code": "invalid_utf8", "params": {} }] },
    { "name": "sms at the limit", "field": "sms", "repeat": { "unit": "a", "count": 160 }, "problems": [] },
    { "name": "sms over the limit", "field": "sms", "repeat": { "unit": "a", "count": 161 }, "problems": [{ "code": "too_long", "params": { "length": 161, "limit": 160 } }] },
    { "name": "two-byte letters count once", "field": "sms", "repeat": { "unit": "ğ", "count": 160 }, "problems": [] },
    { "name": "two-byte letters over the limit", "field": "sms", "repeat": { "unit": "ğ", "count": 161 }, "problems": [{ "code": "too_long", "params": { "length": 161, "limit": 160 } }] },
    { "name": "emoji count once", "field": "sms", "repeat": { "unit": "😀", "count": 160 }, "problems": [] },
    { "name": "subject over the limit", "field": "email_subject", "repeat": { "unit": "ş", "count": 81 }, "problems": [{ "code": "too_long", "params": { "length": 81, "limit": 80 } }] },
    { "name": "body over the limit", "field": "email_body", "repeat": { "unit": "ı", "count": 2001 }, "problems": [{ "code": "too_long", "params": { "length": 2001, "limit": 2000 } }] },
    { "name": "unknown variable", "field": "sms", "text": "Merhaba {{last_name}}", "problems": [{ "code": "unknown_variable", "params": { "name": "last_name", "char": 9 } }] },
    { "name": "variable with spaces", "field": "sms", "text": "Merhaba {{ first_name }}", "problems": [{ "code": "unknown_variable", "params": { "name": " first_name ", "char": 9 } }] },
    { "name": "variable in another case", "field": "sms", "text": "Merhaba {{First_Name}}", "problems": [{ "code": "unknown_variable", "params": { "name": "First_Name", "char": 9 } }] },
    { "name": "empty variable", "field": "sms", "text": "Merhaba {{}}", "problems": [{ "code": "unknown_variable", "params": { "name": "", "char": 9 } }] },
    { "name": "template syntax", "field": "email_body", "text": "{{ .Name }}", "problems": [{ "code": "unknown_variable", "params": { "name": " .Name ", "char": 1 } }] },
    { "name": "single open brace", "field": "sms", "text": "Merhaba {first_name}", "problems": [{ "code": "unbalanced_brace", "params": { "brace": "{", "char": 9 } }, { "code": "unbalanced_brace", "params": { "brace": "}", "char": 20 } }] },
    { "name": "single close brace", "field": "sms", "text": "Merhaba first_name}}", "problems": [{ "code": "unbalanced_brace", "params": { "brace": "}", "char": 19 } }, { "code": "unbalanced_brace", "params": { "brace": "}", "char": 20 } }] },
    { "name": "unclosed variable", "field": "sms", "text": "Merhaba {{first_name", "problems": [{ "code": "unclosed_variable", "params": { "char": 9 } }] },
    { "name": "closed with one brace", "field": "sms", "text": "Merhaba {{first_name}", "problems": [{ "code": "unclosed_variable", "params": { "char": 9 } }] },
    { "name": "extra closing brace", "field": "sms", "text": "Merhaba {{first_name}}}", "problems": [{ "code": "unbalanced_brace", "params": { "brace": "}", "char": 23 } }] },
    { "name": "triple opening brace", "field": "sms", "text": "Merhaba {{{first_name}}}", "problems": [{ "code": "malformed_variable", "params": { "char": 9 } }, { "code": "unbalanced_brace", "params": { "brace": "}", "char": 24 } }] },
    { "name": "json braces", "field": "email_body", "text": "{\"a\": 1}", "problems": [{ "code": "unbalanced_brace", "params": { "brace": "{", "char": 1 } }, { "code": "unbalanced_brace", "params": { "brace": "}", "char": 8 } }] },
    { "name": "character numbers count letters, not bytes", "field": "sms", "text": "çğş {{x}}", "problems": [{ "code": "unknown_variable", "params": { "name": "x", "char": 5 } }] },
    { "name": "an emoji is one character", "field": "sms", "text": "😀 {{x}}", "problems": [{ "code": "unknown_variable", "params": { "name": "x", "char": 3 } }] },
    { "name": "a decomposed i with a combining dot is two characters", "field": "sms", "text": "i\u0307 {{x}}", "problems": [{ "code": "unknown_variable", "params": { "name": "x", "char": 4 } }] },
    { "name": "a ZWJ family emoji is seven characters", "field": "sms", "text": "👨\u200d👩\u200d👧\u200d👦 {{x}}", "problems": [{ "code": "unknown_variable", "params": { "name": "x", "char": 9 } }] },
    { "name": "a long variable name is cut at 40 characters", "field": "sms", "text": "{{aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}}", "problems": [{ "code": "unknown_variable", "params": { "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa…", "char": 1 } }] },
    { "name": "every problem of a field is reported, in order", "field": "email_body", "text": "Hi {{name}} and {{city", "problems": [{ "code": "unknown_variable", "params": { "name": "name", "char": 4 } }, { "code": "unclosed_variable", "params": { "char": 17 } }] }
  ]
}
