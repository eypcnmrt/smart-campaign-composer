ANTHROPIC_API_KEY=
# Optional. Without a key the app starts in mock LLM mode.
# ANTHROPIC_MODEL=claude-opus-5-5
# Set to "off" if the server-side refusal fallback beta is not enabled for the account.
# ANTHROPIC_FALLBACK=on

# Optional: docker compose runs without any of these (the values below are the defaults).
# Database (development values; the database is not published outside the compose network).
# POSTGRES_USER=scc
# POSTGRES_PASSWORD=scc-dev-password
# POSTGRES_DB=scc

# Worker: messages per second and channel, and the timeout of one provider call.
# WORKER_RATE=100
# WORKER_REQUEST_TIMEOUT=5s

# Mock provider behaviour (rates are fractions between 0 and 1; MOCK_SEED makes the failures repeatable).
# MOCK_SEED=1
# MOCK_DELAY_MIN=5ms
# MOCK_DELAY_MAX=25ms
# MOCK_ERROR_RATE=0
# MOCK_THROTTLE_RATE=0
# MOCK_RETRY_AFTER=1s
# MOCK_RATE_LIMIT=0
# MOCK_LATE_RATE=0
# MOCK_LATE_DELAY=3s
