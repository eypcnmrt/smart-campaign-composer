ANTHROPIC_API_KEY=
# Optional. Without a key the app starts in mock LLM mode.
# ANTHROPIC_MODEL=claude-opus-5-5
# Set to "off" if the server-side refusal fallback beta is not enabled for the account.
# ANTHROPIC_FALLBACK=on

# LLM mode: auto (default; the real model when a key is set, the demo mock otherwise), anthropic (the key is required, the
# api exits at start-up without it) or mock (never calls the real API, even when a key is set).
# LLM_MODE=auto
# Generations that may run at once. More requests wait a few seconds and then get 503, which protects the credit.
# LLM_MAX_CONCURRENCY=2

# Optional: docker compose runs without any of these (the values below are the defaults).
# Database (development values; the database is not published outside the compose network).
# POSTGRES_USER=scc
# POSTGRES_PASSWORD=scc-dev-password
# POSTGRES_DB=scc

# Worker: messages per second and channel, and the timeout of one provider call.
# WORKER_RATE=100
# WORKER_REQUEST_TIMEOUT=5s
# How often the worker reports its channels (a heartbeat in the database), and how old that report may be before the
# dashboard shows "worker not running" (keep it at several heartbeats).
# WORKER_HEARTBEAT_INTERVAL=2s
# WORKER_STALE_AFTER=10s

# Mock provider behaviour (rates are fractions between 0 and 1; MOCK_SEED makes the failures repeatable).
# MOCK_SEED=1
# MOCK_DELAY_MIN=5ms
# MOCK_DELAY_MAX=25ms
# MOCK_ERROR_RATE=0
# MOCK_THROTTLE_RATE=0
# MOCK_RETRY_AFTER=1s
# MOCK_RATE_LIMIT=0
# MOCK_LATE_RATE=0
# MOCK_LATE_DELAY=3s
